# SPDX-License-Identifier: Community-Spec-1.0
#
# OWL ontology and SHACL shapes for the example SyntheticData SPDX 3 extension.
# Written by hand in the style of https://spdx.org/rdf/3.0.1/spdx-model.ttl

@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix spdx-ext: <https://spdx.org/rdf/3.0.1/terms/Extension/> .
@prefix spdx-ai: <https://spdx.org/rdf/3.0.1/terms/AI/> .
@prefix sd: <https://example.org/spdx3-ext/synthetic-data/> .
@prefix sdgm: <https://example.org/spdx3-ext/synthetic-data/DataGenerationMethodType/> .

<https://example.org/spdx3-ext/synthetic-data> a owl:Ontology ;
    rdfs:label "SyntheticData SPDX 3 extension (example)"@en ;
    owl:versionInfo "0.1.0" .

sd:SyntheticDataExtension a owl:Class, sh:NodeShape ;
    rdfs:comment "Describes how the content of a dataset was generated."@en ;
    rdfs:subClassOf spdx-ext:Extension ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:property [
            sh:path sd:generationMethod ;
            sh:class sd:DataGenerationMethodType ;
            sh:in ( sdgm:humanGenerated sdgm:machineGenerated sdgm:mixed sdgm:noAssertion ) ;
            sh:nodeKind sh:IRI ;
            sh:minCount 1 ;
            sh:maxCount 1 ] ,
        [
            sh:path sd:syntheticFraction ;
            sh:datatype xsd:decimal ;
            sh:minInclusive 0 ;
            sh:maxInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:maxCount 1 ] ,
        [
            sh:path sd:generatorModel ;
            sh:class spdx-ai:AIPackage ;
            sh:nodeKind sh:IRI ] .

sd:DataGenerationMethodType a owl:Class ;
    rdfs:comment "Categories of how dataset content was generated."@en .

sdgm:humanGenerated a owl:NamedIndividual, sd:DataGenerationMethodType ;
    rdfs:label "humanGenerated" ;
    rdfs:comment "Content was created or collected by humans, or recorded from the real world, without machine generation."@en .

sdgm:machineGenerated a owl:NamedIndividual, sd:DataGenerationMethodType ;
    rdfs:label "machineGenerated" ;
    rdfs:comment "Content was generated by a machine, such as an AI model or a simulation (synthetic data)."@en .

sdgm:mixed a owl:NamedIndividual, sd:DataGenerationMethodType ;
    rdfs:label "mixed" ;
    rdfs:comment "Content combines human-generated and machine-generated parts."@en .

sdgm:noAssertion a owl:NamedIndividual, sd:DataGenerationMethodType ;
    rdfs:label "noAssertion" ;
    rdfs:comment "No assertion is made about how the content was generated."@en .

sd:generationMethod a owl:ObjectProperty ;
    rdfs:comment "How the content of a dataset was generated."@en ;
    rdfs:range sd:DataGenerationMethodType .

sd:syntheticFraction a owl:DatatypeProperty ;
    rdfs:comment "Fraction of the dataset content that is machine-generated."@en ;
    rdfs:range xsd:decimal .

sd:generatorModel a owl:ObjectProperty ;
    rdfs:comment "AI model used to generate the synthetic content of a dataset."@en ;
    rdfs:range spdx-ai:AIPackage .
